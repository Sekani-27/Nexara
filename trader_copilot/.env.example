# ─────────────────────────────────────────────────────────────
#  Trader Copilot — environment variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Telegram credentials
# Get a bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwXYZ

# Your personal chat ID or a group/channel ID.
# Send a message to your bot then visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read the "chat" > "id" field.
TELEGRAM_CHAT_ID=987654321

# ─────────────────────────────────────────────────────────────
#  Massive / Polygon.io (fallback data source on Railway/Linux)
#  Get a key at https://polygon.io
# ─────────────────────────────────────────────────────────────
MASSIVE_API_KEY=your-polygon-api-key-here

# ─────────────────────────────────────────────────────────────
#  MetaTrader 5 (if applicable)
# ─────────────────────────────────────────────────────────────
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

# ─────────────────────────────────────────────────────────────
#  Qdrant memory store
# ─────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=trade_memory
QDRANT_MODEL=all-MiniLM-L6-v2
