# Force LF line endings in the repo — prevents CRLF/LF black formatting drift
# between Windows dev machines and Linux CI.
* text=auto eol=lf

# Explicitly LF for all source types
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.env  text eol=lf

# Binaries — no line-ending conversion
*.db    binary
*.ex5   binary
*.pkl   binary
*.joblib binary
