# Prop firm config
ACTIVE_FIRM=goat                    # required | goat | ftmo | the5ers
ACCOUNT_SIZE=8000                   # required | integer | funded account size USD
ACCOUNT_STEP=1                      # required | 1 | 2 | 3

# Telegram
TELEGRAM_BOT_TOKEN=                 # required | from @BotFather
TELEGRAM_CHAT_ID=                   # required | from @userinfobot

# Risk Guard
RISK_GUARD_DB_PATH=/app/data/risk_guard.db  # required

# MT5 (optional — Windows only)
MT5_LOGIN=                          # optional | MT5 account number
MT5_PASSWORD=                       # optional | MT5 trading password
MT5_SERVER=GOATFunded-Live01        # optional | MT5 broker server

# TwelveData (required for cloud deployment)
TWELVEDATA_API_KEY=                 # required | primary key
TWELVEDATA_API_KEY_2=               # required | second key for rate limit splitting

# Massive/Polygon (optional)
MASSIVE_API_KEY=                    # optional | stocks only on free tier

# Qdrant (optional)
QDRANT_HOST=localhost               # optional
QDRANT_PORT=6333                    # optional
QDRANT_COLLECTION=trade_memory      # optional
QDRANT_MODEL=all-MiniLM-L6-v2      # optional
